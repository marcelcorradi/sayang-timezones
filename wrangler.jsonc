// Hospedagem no Cloudflare: só arquivos estáticos (sem código de Worker), servidos de graça.
// O login fica no Cloudflare Access, ligado no painel (Settings → Domains & Routes).
{
  "name": "sayang-timezones",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Um endereço só: sem URLs de preview por versão.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
